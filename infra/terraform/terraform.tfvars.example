# -----------------------------------------------------------------------------
# JOL-HUB Terraform Variables — Example Configuration
# -----------------------------------------------------------------------------
# Copy this file to terraform.tfvars and customize for your environment
# -----------------------------------------------------------------------------

# Environment settings
environment = "staging"
aws_region  = "eu-west-1"

# VPC configuration
vpc_cidr = "10.0.0.0/16"
az_count = 3

# Database configuration
postgres_version            = "16.3"
rds_instance_class          = "db.t3.medium"
rds_allocated_storage       = 20
rds_max_allocated_storage   = 100
rds_backup_retention_days   = 7
rds_multi_az                = false
rds_enable_performance_insights = true

# ElastiCache configuration
redis_version           = "7.1"
redis_node_type         = "cache.t3.micro"
redis_num_cache_clusters = 2

# ECS configuration
django_cpu           = "512"
django_memory        = "1024"
django_desired_count = 2
django_min_count     = 2
django_max_count     = 10

celery_cpu                  = "256"
celery_memory               = "512"
celery_worker_desired_count = 2
celery_worker_min_count     = 1
celery_worker_max_count     = 10

# SSL/TLS certificates (required)
# Create these in ACM first
alb_certificate_arn      = "arn:aws:acm:eu-west-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
cloudfront_certificate_arn = ""

# DNS configuration (optional)
route53_zone_id = "Z1234567890ABC"
app_domain      = "api-staging.journeyoflife.org"

# Monitoring (optional)
alarm_sns_topic_arn = ""

# Security
enable_bastion      = false
allowed_admin_cidrs = []

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Secrets are stored in AWS Secrets Manager with KMS encryption
# Payment secrets use a separate KMS key for PCI-DSS compliance
# -----------------------------------------------------------------------------

# Secret retention (days before permanent deletion)
secrets_recovery_window_days = 7

# Enable automatic secret rotation (Lambda-based)
enable_secret_rotation = false

# Payment Secrets (PCI-DSS Scoped)
# IMPORTANT: These are stored with separate KMS key for PCI compliance
# Card-processor (PSP) variables purged STEP 18 (Model A / ADR-0005):
# hub never holds PSP credentials; the marketplace payment boundary does.
# stripe_secret_key       = "sk_live_xxxx"  # REMOVED — never re-add
# stripe_publishable_key  = "pk_live_xxxx"  # REMOVED — never re-add
# stripe_webhook_secret   = "whsec_xxxx"    # REMOVED — never re-add
# paypal_client_id        = "AXxxx"
# paypal_client_secret    = "xxxx"
# paypal_mode             = "live"

# Email Secrets
# email_host              = "smtp.gmail.com"
# email_port              = 587
# email_host_user         = "noreply@journeyoflife.org"
# email_host_password     = "app-password"  # Set via environment variable
# email_use_tls           = true

# Integration Secrets
# bitrix24_webhook_url    = "https://portal.bitrix24.com/rest/1/webhook/"
# bitrix24_portal_id      = "portal.bitrix24.com"
# bitrix24_contact_group_id = "123"

# OAuth Secrets (Social Login)
# google_oauth_client_id     = "xxx.apps.googleusercontent.com"
# google_oauth_client_secret = "GOCSPX-xxx"
# facebook_oauth_client_id   = "123456789"
# facebook_oauth_client_secret = "xxx"

# -----------------------------------------------------------------------------
# HASHICORP VAULT (OPTIONAL)
# -----------------------------------------------------------------------------
# Use HashiCorp Vault instead of AWS Secrets Manager
# Set enable_vault = true and configure vault_addr
# -----------------------------------------------------------------------------

enable_vault     = false
vault_addr       = "https://vault.jol-hub.eu"
vault_namespace  = "jol-hub/staging"
