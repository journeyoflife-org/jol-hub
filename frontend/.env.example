# =============================================================================
# JOL-HUB Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# =============================================================================

# Bitrix24 OAuth Configuration
BITRIX_AUTH_URL=https://your-domain.bitrix24.com
BITRIX_CLIENT_ID=your-bitrix-client-id
BITRIX_CLIENT_SECRET=your-bitrix-client-secret

# Django Backend API
DJANGO_API_URL=http://localhost:8000/api/v1

# Deep API (for translations/content)
DEEP_API_KEY=your-deep-api-key

# NextAuth.js Configuration
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Database (if needed for parish templates)
DATABASE_URL=postgresql://user:password@localhost:5432/jol_hub

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Security
CSP_REPORT_URI=https://your-report-uri.com/csp-report

# Feature Flags
ENABLE_GDPR_BANNER=true
ENABLE_ANALYTICS=false

# i18n
DEFAULT_LOCALE=lt
SUPPORTED_LOCALES=lt,ru,en
