# Master Site Environment Variables
# Copy to .env.local

# Bitrix24 OAuth
BITRIX_AUTH_URL=https://your-domain.bitrix24.com
BITRIX_CLIENT_ID=your-client-id
BITRIX_CLIENT_SECRET=your-client-secret

# Django API
DJANGO_API_URL=http://localhost:8000/api/v1

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
