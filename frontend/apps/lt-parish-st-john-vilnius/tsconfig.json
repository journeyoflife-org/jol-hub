{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@journeyoflife-org/ui": [
        "../../packages/ui/src"
      ],
      "@journeyoflife-org/i18n": [
        "../../packages/i18n/src"
      ],
      "@journeyoflife-org/auth": [
        "../../packages/auth/src"
      ],
      "@journeyoflife-org/bitrix-sdk": [
        "../../packages/bitrix-sdk/src"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
