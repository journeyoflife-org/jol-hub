# =============================================================================
# template-renderer — STAGING environment TEMPLATE (STEP 17, Wave 0)
# =============================================================================
# Staging mirrors production CONFIGURATION with:
#   - staging domains (*.staging.gyvenimo-kelias.lt),
#   - anonymized production-like data,
#   - TEST-MODE credentials only (PCI-DSS pilot rule: no live keys until
#     SAQ A is verified),
#   - its own Vault namespace — production secrets NEVER enter staging.
# Pre-production gate: ALL E2E tiers must pass on staging before a
# production deploy (see docs/wave0/WAVE0-CHECKLIST.md).
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# --- Hub backend planes (staging Proxmox cluster) --------------------------
BACKEND_API_URL=https://api.staging.gyvenimo-kelias.lt
BACKEND_SERVICE_TOKEN=__INJECT_FROM_VAULT:staging/backend/service-token__

COMMERCE_API_URL=https://commerce.staging.gyvenimo-kelias.lt

# --- jol-auth (staging realm) ----------------------------------------------
JOL_AUTH_ISSUER=https://auth.staging.gyvenimo-kelias.lt
JOL_AUTH_CLIENT_ID=__INJECT_FROM_VAULT:staging/auth/client-id__
JOL_AUTH_CLIENT_SECRET=__INJECT_FROM_VAULT:staging/auth/client-secret__
NEXTAUTH_SECRET=__INJECT_FROM_VAULT:staging/auth/nextauth-secret__
NEXTAUTH_URL=https://staging.gyvenimo-kelias.lt

# --- Payments: TEST MODE ONLY — server-side keys stay on the backend -----
# payments plane (injected from the staging Vault namespace; ADR-0005
# keeps them out of this repo entirely).

# --- CRM: Bitrix24 TEST sandbox (never the production CRM) ------------------
BITRIX24_WEBHOOK_URL=__INJECT_FROM_VAULT:staging/crm/bitrix-test-webhook__

# --- Public ------------------------------------------------------------------
NEXT_PUBLIC_TENANT_DOMAIN=staging.gyvenimo-kelias.lt
NEXT_PUBLIC_DEFAULT_LOCALE=lt

APP_VERSION=__INJECT_BY_DEPLOY__
