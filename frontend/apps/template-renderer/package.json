{
  "name": "@jol-hub/template-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Single multi-tenant renderer replacing the legacy lt-* per-entity demo apps (STEP 1, ADR-002)",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:vitest": "vitest run",
    "test:vitest:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:security": "vitest run src/__tests__/vitest/security.test.tsx",
    "check-a11y": "tsx scripts/check-a11y-pages.ts",
    "check-perf": "tsx scripts/check-perf-budget.ts",
    "check-secrets": "tsx scripts/check-secrets.ts",
    "analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@jol-hub/a11y": "workspace:*",
    "@jol-hub/auth": "workspace:*",
    "@jol-hub/bitrix-sdk": "workspace:*",
    "@jol-hub/commerce": "workspace:*",
    "@jol-hub/i18n": "workspace:*",
    "@jol-hub/observability": "workspace:*",
    "@jol-hub/perf": "workspace:*",
    "@jol-hub/seed-data": "workspace:*",
    "@jol-hub/seo": "workspace:*",
    "@jol-hub/tenant-resolver": "workspace:*",
    "@jol-hub/ui": "workspace:*",
    "dompurify": "^3.4.14",
    "intl-messageformat": "^11.2.14",
    "lucide-react": "^0.358.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jol-hub/testing": "workspace:*",
    "@next/bundle-analyzer": "14.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "msw": "^2.15.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
