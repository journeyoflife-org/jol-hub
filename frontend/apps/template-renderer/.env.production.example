# =============================================================================
# template-renderer — PRODUCTION environment TEMPLATE (STEP 17, Wave 0)
# =============================================================================
# SECURITY RULES (non-negotiable):
#   - This file is committed as a TEMPLATE ONLY. Real values are injected at
#     deploy time from Ansible Vault / the secrets manager (Vaultwarden).
#   - NEVER paste real secrets into any committed file, ticket or log.
#   - `.env.production` itself is git-ignored; CI scans build output for
#     leaked values (scripts/check-secrets.ts).
# =============================================================================

NODE_ENV=production
LOG_LEVEL=warn

# --- Hub backend planes (internal Proxmox addresses, TLS terminated at lb) -
BACKEND_API_URL=https://api.gyvenimo-kelias.lt
# Service token for server-to-server calls (X-Tenant carries RLS context).
BACKEND_SERVICE_TOKEN=__INJECT_FROM_VAULT:backend/service-token__

COMMERCE_API_URL=https://commerce.gyvenimo-kelias.lt

# --- jol-auth (OIDC) — STEP 10 --------------------------------------------
JOL_AUTH_ISSUER=https://auth.gyvenimo-kelias.lt
JOL_AUTH_CLIENT_ID=__INJECT_FROM_VAULT:auth/client-id__
JOL_AUTH_CLIENT_SECRET=__INJECT_FROM_VAULT:auth/client-secret__
NEXTAUTH_SECRET=__INJECT_FROM_VAULT:auth/nextauth-secret__
NEXTAUTH_URL=https://gyvenimo-kelias.lt

# --- Payments — ADR-007: boundary stays CLOSED in the pilot ---------------
# Payment keys live on the BACKEND payments plane only and are injected
# from Vaultwarden there — never in this repo (ADR-0005 Model A). The
# frontend renders the honest pending-payments notice until the boundary
# opens (PCI SAQ A verified; test mode first).

# --- CRM (Bitrix24) — webhook travels via the backend proxy ---------------
BITRIX24_WEBHOOK_URL=__INJECT_FROM_VAULT:crm/bitrix-webhook__

# --- Public (safe to ship) -------------------------------------------------
NEXT_PUBLIC_TENANT_DOMAIN=gyvenimo-kelias.lt
NEXT_PUBLIC_DEFAULT_LOCALE=lt

# --- Ops -------------------------------------------------------------------
APP_VERSION=__INJECT_BY_DEPLOY__
