# =============================================================================
# JOL-HUB Admin Dashboard Environment Configuration
# =============================================================================
# Qoder generates this template
# Copy to .env.local and fill in (NEVER commit .env.local)
# 
# SECURITY NOTE: The .env.local file is in .gitignore (never uploaded to GitHub)
# If you accidentally commit secrets, immediately rotate them (change passwords/keys)
# because hackers scan GitHub for leaked credentials.
# =============================================================================

# =============================================================================
# Application Core
# =============================================================================
NEXT_PUBLIC_APP_NAME=JOL-HUB Admin
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3002

# =============================================================================
# NextAuth.js (Authentication)
# GDPR: Session data stored in country-specific backends
# =============================================================================
NEXTAUTH_URL=http://localhost:3002
# Generate strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32-change-me

# =============================================================================
# Django Backend API (Country-specific endpoints)
# GDPR Article 44: Data cannot cross borders - each country has own backend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Country-specific GraphQL endpoints (GDPR Article 44 residency)
# Lithuania
NEXT_PUBLIC_API_URL_LT=http://api.gyvenimo-kelias.lt/graphql
# Latvia
NEXT_PUBLIC_API_URL_LV=http://api.dzives-cels.lv/graphql
# Estonia
NEXT_PUBLIC_API_URL_EE=http://api.elutee.ee/graphql
# Poland
NEXT_PUBLIC_API_URL_PL=http://api.zycia-droga.pl/graphql
# Germany
NEXT_PUBLIC_API_URL_DE=http://api.lebensweg.de/graphql
# France
NEXT_PUBLIC_API_URL_FR=http://api.chemin-vie.fr/graphql
# Italy
NEXT_PUBLIC_API_URL_IT=http://api.cammino-vita.it/graphql
# Spain
NEXT_PUBLIC_API_URL_ES=http://api.camino-vida.es/graphql
# Netherlands
NEXT_PUBLIC_API_URL_NL=http://api.levensweg.nl/graphql
# Belgium
NEXT_PUBLIC_API_URL_BE=http://api.levensweg.be/graphql
# Austria
NEXT_PUBLIC_API_URL_AT=http://api.lebensweg.at/graphql
# Czech Republic
NEXT_PUBLIC_API_URL_CZ=http://api.zivotni-cesta.cz/graphql
# Slovakia
NEXT_PUBLIC_API_URL_SK=http://api.zivotna-cesta.sk/graphql
# Hungary
NEXT_PUBLIC_API_URL_HU=http://api.eletut.hu/graphql
# Romania
NEXT_PUBLIC_API_URL_RO=http://api.drumul-vietii.ro/graphql
# Bulgaria
NEXT_PUBLIC_API_URL_BG=http://api.zhivoten-put.bg/graphql
# Greece
NEXT_PUBLIC_API_URL_GR=http://api.monopati-zois.gr/graphql
# Cyprus
NEXT_PUBLIC_API_URL_CY=http://api.monopati-zois.cy/graphql
# Malta
NEXT_PUBLIC_API_URL_MT=http://api.trip-hajja.mt/graphql
# Portugal
NEXT_PUBLIC_API_URL_PT=http://api.caminho-vida.pt/graphql
# Ireland
NEXT_PUBLIC_API_URL_IE=http://api.path-life.ie/graphql
# Denmark
NEXT_PUBLIC_API_URL_DK=http://api.livsvej.dk/graphql
# Sweden
NEXT_PUBLIC_API_URL_SE=http://api.livsvag.se/graphql
# Finland
NEXT_PUBLIC_API_URL_FI=http://api.elamanpolku.fi/graphql
# Croatia
NEXT_PUBLIC_API_URL_HR=http://api.put-zivota.hr/graphql
# Slovenia
NEXT_PUBLIC_API_URL_SI=http://api.pot-zivljenja.si/graphql

# =============================================================================
# Bitrix24 (Real-time Sync)
# Circuit breaker prevents cascade failures
# =============================================================================
# Webhook signing secret (prevents spoofing)
BITRIX24_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here
# OAuth application credentials
BITRIX24_CLIENT_ID=your-bitrix24-oauth-client-id
BITRIX24_CLIENT_SECRET=your-bitrix24-oauth-client-secret
# Bitrix24 domain (your organization's Bitrix24 instance)
BITRIX24_DOMAIN=journeyoflife.bitrix24.ru
# Circuit breaker configuration
BITRIX24_CIRCUIT_BREAKER_THRESHOLD=5
BITRIX24_CIRCUIT_BREAKER_RESET_MS=60000

# =============================================================================
# Encryption (GDPR Article 32: Security of Processing)
# AES-256 key for file encryption before upload
# Generate: openssl rand -hex 32
# =============================================================================
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32-change-me

# =============================================================================
# OAuth Providers (Optional)
# =============================================================================
# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# JWT Configuration
# =============================================================================
NEXT_PUBLIC_JWT_ACCESS_TOKEN_EXPIRY=15
NEXT_PUBLIC_JWT_REFRESH_TOKEN_EXPIRY=7

# =============================================================================
# Feature Flags
# Toggle features without code changes
# =============================================================================
# Bitrix24 real-time sync
NEXT_PUBLIC_ENABLE_BITRIX_SYNC=true
# GDPR data residency map visualization
NEXT_PUBLIC_ENABLE_GDPR_MAP=true
# Canonical approval workflow (Canon Law CIC 1300-1307)
NEXT_PUBLIC_ENABLE_CANONICAL_WORKFLOW=true
# Analytics dashboard
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Debug mode (disable in production)
NEXT_PUBLIC_ENABLE_DEBUG_MODE=true
# Mock data for development
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# =============================================================================
# GDPR Configuration
# Article 44: Data Residency Enforcement
# =============================================================================
GDPR_STRICT_MODE=true
GDPR_DATA_RESIDENCY_DEFAULT=EU
# Enable cross-country data access (DISABLED for compliance)
GDPR_ALLOW_CROSS_COUNTRY_ACCESS=false
# Cookie consent banner
GDPR_COOKIE_CONSENT_REQUIRED=true

# =============================================================================
# Canon Law Configuration
# CIC 1300-1307: Episcopal Approval Workflow
# =============================================================================
CANONICAL_APPROVAL_REQUIRED=true
# Vatican processing timeline (days)
CANONICAL_VATICAN_PROCESSING_DAYS=30-90

# =============================================================================
# SOC2 Configuration
# CC6.1: Security Controls
# =============================================================================
SOC2_EMERGENCY_STOP_ENABLED=true
SOC2_AUDIT_LOGGING_ENABLED=true
SOC2_CIRCUIT_BREAKER_ENABLED=true

# =============================================================================
# ISO 27001 Configuration
# Information Security Management
# =============================================================================
ISO27001_ENCRYPTION_REQUIRED=true
ISO27001_ACCESS_CONTROL_ENABLED=true

# =============================================================================
# Database (Local Development)
# =============================================================================
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/jol_hub

# =============================================================================
# Redis (Caching and Sessions)
# =============================================================================
# REDIS_URL=redis://localhost:6379
# Redis for circuit breaker state
# REDIS_CIRCUIT_BREAKER_DB=1
# Redis for session storage
# REDIS_SESSION_DB=2

# =============================================================================
# DeepL API (Translation Services)
# Liturgical content requires special handling
# =============================================================================
DEEP_API_KEY=your-deepl-api-key
# Enable liturgical term preservation
DEEP_PRESERVE_LITURGICAL_TERMS=true

# =============================================================================
# Email Configuration
# Transactional emails for canonical workflow
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@jol-hub.eu
# EMAIL_FROM_NAME=JOL-HUB

# =============================================================================
# Monitoring and Error Tracking
# =============================================================================
# Sentry
# SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# Logging
# =============================================================================
NEXT_PUBLIC_LOG_LEVEL=debug
# Log levels: debug, info, warn, error
# Production should use 'info' or 'warn'

# =============================================================================
# i18n (Internationalization)
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Supported locales: EU member state languages
NEXT_PUBLIC_SUPPORTED_LOCALES=en,lt,lv,et,pl,de,fr,it,es,nl,cs,sk,hu,ro,bg,el,mt,pt,ga,da,sv,fi,hr,sl

# =============================================================================
# Security Headers
# =============================================================================
# Content Security Policy report URI
CSP_REPORT_URI=https://your-report-uri.com/csp-report
# Strict Transport Security
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
