{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "env": [
    "NODE_ENV",
    "BITRIX_AUTH_URL",
    "BITRIX_CLIENT_ID",
    "BITRIX_CLIENT_SECRET",
    "DJANGO_API_URL",
    "DEEP_API_KEY",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL"
  ]
}
