# Django backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Access token lifetime must match Django SIMPLE_JWT ACCESS_TOKEN_LIFETIME (seconds)
NEXT_PUBLIC_ACCESS_TOKEN_LIFETIME_S=900

# Refresh token lifetime must match Django SIMPLE_JWT REFRESH_TOKEN_LIFETIME (seconds)
NEXT_PUBLIC_REFRESH_TOKEN_LIFETIME_S=604800

# Application name shown in browser title
NEXT_PUBLIC_APP_NAME=JOL-HUB

# Environment label: development | staging | production
NEXT_PUBLIC_ENV=development
