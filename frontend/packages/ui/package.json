{
  "name": "@journeyoflife-org/ui",
  "version": "1.0.0",
  "description": "JOL design system: Radix-based primitives, composite components, layout families, design tokens, and Tailwind configuration.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js"
    },
    "./tailwind": "./tailwind.config.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./components/primitives": {
      "types": "./dist/components/primitives/index.d.ts",
      "import": "./dist/components/primitives/index.mjs",
      "require": "./dist/components/primitives/index.js"
    },
    "./components/composite": {
      "types": "./dist/components/composite/index.d.ts",
      "import": "./dist/components/composite/index.mjs",
      "require": "./dist/components/composite/index.js"
    },
    "./components/layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.mjs",
      "require": "./dist/components/layout/index.js"
    },
    "./components/accessibility": {
      "types": "./dist/components/accessibility/index.d.ts",
      "import": "./dist/components/accessibility/index.mjs",
      "require": "./dist/components/accessibility/index.js"
    },
    "./components/locale-switcher": {
      "types": "./dist/components/locale-switcher/index.d.ts",
      "import": "./dist/components/locale-switcher/index.mjs",
      "require": "./dist/components/locale-switcher/index.js"
    },
    "./dev/showcase": {
      "types": "./dist/dev/Showcase.d.ts",
      "import": "./dist/dev/Showcase.mjs",
      "require": "./dist/dev/Showcase.js"
    }
  },
  "files": [
    "dist",
    "src/styles",
    "src/tokens",
    "tailwind.config.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "generate:tokens": "tsx scripts/generate-css.ts",
    "check-contrast": "tsx scripts/check-contrast.ts",
    "check-a11y": "tsx scripts/check-a11y.tsx",
    "verify": "tsc --noEmit && tsx --test src/__tests__/*.test.ts && tsx scripts/check-contrast.ts && tsx scripts/check-a11y.tsx"
  },
  "dependencies": {
    "@journeyoflife-org/i18n": "workspace:*",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.358.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "axe-core": "^4.10.0",
    "jsdom": "^24.1.0",
    "next": "^14.2.35",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
