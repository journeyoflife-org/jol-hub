    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "peerDependencies": {
    "@testing-library/react": ">=16",
    "vitest": ">=4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.3",
    "msw": "^2.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
