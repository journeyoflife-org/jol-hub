{
  "name": "@journeyoflife-org/testing",
  "version": "1.0.0",
  "description": "Shared test harness for the JOL frontend (STEP 15): vitest setup, provider-aware RTL render, deterministic mocks (tenant/auth/API) and reusable fixtures. Deterministic + isolated by contract: no network, no real time, no shared state.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.mjs",
      "require": "./dist/setup.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@journeyoflife-org/i18n": "workspace:*",
    "@journeyoflife-org/tenant-resolver": "workspace:*",
    "@journeyoflife-org/ui": "workspace:*",
    "intl-messageformat": "^11.2.14",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "peerDependencies": {
    "@testing-library/react": ">=16",
    "vitest": ">=4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.3",
    "msw": "^2.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
