{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Workspace packages are consumed as TS source; some use classic React
    // imports which are unused under react-jsx — not our code to reformat.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}
