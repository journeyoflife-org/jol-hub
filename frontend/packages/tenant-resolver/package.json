{
  "name": "@jol-hub/tenant-resolver",
  "version": "1.0.0",
  "description": "Tenant resolution (X-Tenant header / subdomain) for the JOL template renderer",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@jol-hub/seed-data": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  }
}
