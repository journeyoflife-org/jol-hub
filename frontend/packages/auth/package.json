{
  "name": "@journeyoflife-org/auth",
  "version": "1.0.0",
  "description": "Authentication and authorization for JOL: NextAuth integration, Bitrix24 OAuth2, parish-level access guards, and OIDC hooks.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/parish-guard.d.ts",
      "import": "./dist/middleware/parish-guard.mjs",
      "require": "./dist/middleware/parish-guard.js"
    },
    "./hooks": {
      "types": "./dist/hooks/useBitrixAuth.d.ts",
      "import": "./dist/hooks/useBitrixAuth.mjs",
      "require": "./dist/hooks/useBitrixAuth.js"
    },
    "./api": {
      "types": "./dist/lib/bitrix-api.d.ts",
      "import": "./dist/lib/bitrix-api.mjs",
      "require": "./dist/lib/bitrix-api.js"
    },
    "./oidc": {
      "types": "./dist/oidc/index.d.ts",
      "import": "./dist/oidc/index.mjs",
      "require": "./dist/oidc/index.js"
    },
    "./oidc/hooks": {
      "types": "./dist/oidc/hooks.d.ts",
      "import": "./dist/oidc/hooks.mjs",
      "require": "./dist/oidc/hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/oidc/__tests__/*.test.ts",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "next-auth": "^4.24.15"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "next": "14.2.35",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0"
  }
}
