{
  "name": "@jol-hub/bitrix-sdk",
  "version": "1.0.0",
  "description": "Bitrix24 REST API SDK: OAuth2 token lifecycle, lead/contact CRUD, webhook helpers and typed response shapes. Zero runtime deps beyond zod for validation.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  }
}
