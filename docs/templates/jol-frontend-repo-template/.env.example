# =============================================================================
# JOL Site Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — only .env.example is tracked.
# =============================================================================

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=__VERTICAL_NAME__

# --- Tenant Resolution ---
# Set by middleware; override for local dev only
NEXT_PUBLIC_TENANT_SLUG=__VERTICAL__
NEXT_PUBLIC_DEFAULT_LOCALE=lt

# --- Bitrix24 Auth (OIDC) ---
BITRIX24_DOMAIN=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# --- API ---
# Hub API endpoint (internal)
HUB_API_URL=http://localhost:8000
# Tenant-scoped API key (from hub admin)
TENANT_API_KEY=

# --- Sentry (error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics (consent-gated) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Feature Flags ---
# Enable test-mode payment events receiver (flag-gated, hub only)
NEXT_PUBLIC_PAYMENT_TEST_MODE=false
