[flake8]
# Flake8 config for JOL Hub backend
# CI command: flake8 . --max-line-length=100 --exclude=migrations,venv,__pycache__,node_modules

max-line-length = 100
exclude =
    migrations,
    venv,
    __pycache__,
    node_modules,
    .venv

# Ignore pre-existing violations that require separate cleanup PRs:
# E402: module level import not at top of file - intentional in some __init__.py
# E501: line too long - Black handles line length; some docstrings/URLs exceed limit
# F401: unused imports - many exist; isort manages ordering, not usage
# F402: import shadowed by loop variable - pre-existing, separate cleanup
# F403: star import used - settings/* use star imports from base
# F405: may be undefined from star imports - settings/* use star imports from base
# F541: f-string without placeholders - cosmetic, separate cleanup
# F811: redefinition of unused names - common in decorator patterns
# F821: undefined names - AuditEntry references need real fix (tracked)
# F841: local variable assigned but never used - cosmetic, separate cleanup
# W291: trailing whitespace - cosmetic
# W293: blank line contains whitespace - cosmetic
# W503: line break before binary operator - PEP 8 now recommends this style
ignore = E402,E501,F401,F402,F403,F405,F541,F811,F821,F841,W291,W293,W503
