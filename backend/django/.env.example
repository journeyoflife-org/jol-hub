# =============================================================================
# D J A N G O   C O R E
# =============================================================================
DEBUG=True
SECRET_KEY=change-me-in-production-use-50-char-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://user:password@localhost:5432/jol_hub

# =============================================================================
# S E C U R I T Y   &   G D P R
# =============================================================================
# GDPR Cookie/Consent settings
GDPR_COOKIE_DOMAIN=.localhost
GDPR_SECURE_COOKIE=False  # Set True in production (HTTPS only)

# MFA Settings (users app)
MFA_TOTP_ISSUER_NAME=JourneyOfLife Hub

# =============================================================================
# C E L E R Y   &   R E D I S
# =============================================================================
# core app - Celery tasks (cleanup_sessions, test_task)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False  # Set True for local testing (sync mode)

# =============================================================================
# P A Y M E N T S   (donations app)
# =============================================================================
# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_for_integrations_app

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # Change to 'live' in production

# Gift Aid (UK specific - donations app)
GIFT_AID_ENABLED=True

# =============================================================================
# I N T E G R A T I O N S
# =============================================================================
# Webhook event processing (integrations app)
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30

# Outbound request audit logging
AUDIT_LOG_RETENTION_DAYS=90

# =============================================================================
# F I N A N C I A L   &   I N V O I C I N G
# =============================================================================
# Default VAT rate (countries app overrides this per country)
DEFAULT_VAT_RATE=20.0
INVOICE_NUMBER_PREFIX=JOL-

# =============================================================================
# E M A I L   (for GDPR export/notifications)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # Dev: prints to console
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # Production
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default from address
DEFAULT_FROM_EMAIL=noreply@journeyoflife.org
GDPR_EXPORT_EMAIL_SUBJECT="Your Data Export from JourneyOfLife"
