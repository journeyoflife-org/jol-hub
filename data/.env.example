# JOL-HUB Data Module Environment Variables
# Copy to .env and fill in values
# NEVER commit .env with real secrets!

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jolhub
DB_USER=jolhub
DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Airflow Configuration
AIRFLOW_HOME=/opt/jol/repos/jol-hub/data/airflow
AIRFLOW__CORE__DAGS_FOLDER=/opt/jol/repos/jol-hub/data/airflow/dags
AIRFLOW__CORE__PLUGINS_FOLDER=/opt/jol/repos/jol-hub/data/airflow/plugins

# Audit Logging
AUDIT_LOG_DIR=/var/log/jol-hub/audit
GDPR_LOG_LEVEL=INFO

# GDPR Settings
GDPR_DEFAULT_RETENTION_DAYS=2555
GDPR_K_ANONYMITY_VALUE=5
GDPR_ENABLE_AUDIT_LOGGING=true

# Country Database Connections (for dbt)
# Format: DB_<COUNTRY_CODE>_HOST
DB_LT_HOST=localhost
DB_LV_HOST=localhost
DB_EE_HOST=localhost
# ... add all 27 countries

# Email Notifications (for compliance alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@jol-hub.eu
SMTP_PASSWORD=your_smtp_password
ALERT_EMAIL=dpo@jol-hub.eu

# Encryption Key Management
# ISO 27001 A.10.1.2, SOC2 CC6.1 - Cryptographic key management
# 
# Provider options: aws_kms (production), local (development only), hsm
# IMPORTANT: Use aws_kms for production environments
ENCRYPTION_PROVIDER=local

# AWS KMS Configuration (required for production)
# Create a customer-managed key in AWS KMS and reference its ID
# Key should have automatic rotation enabled in AWS
AWS_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AWS_REGION=eu-west-1

# Key Rotation Settings
# Keys are automatically rotated after this many days
# ISO 27001 recommends annual rotation (365 days)
KEY_ROTATION_DAYS=90

# Auto-rotation enables seamless key transitions
# Set to false in environments where manual rotation is required
AUTO_KEY_ROTATION=true

# Local Key Store Path (development only)
# NOT SUITABLE FOR PRODUCTION
KEY_STORE_PATH=/var/lib/jol-hub/keys

# DEPRECATED: Plain encryption key (migrate to KMS)
# This will be removed in a future version
# PII_ENCRYPTION_KEY=your_encryption_key_here

# Feature Flags
ENABLE_K_ANONYMITY=true
ENABLE_DIFFERENTIAL_PRIVACY=false
ENABLE_LEGAL_HOLD_CHECKS=true
