# ===========================================
# JOL-HUB Comprehensive .gitignore
# SOC2 Type II / GDPR Article 9 Compliant
# ===========================================

# === CRITICAL: Data & Secrets ===
# Database files (GDPR PII risk)
*.sqlite3
*.sqlite
*.db
db.sqlite3
backend/db.sqlite3

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example
!.env.local.example

# Encryption keys
*.pem
*.key
secrets/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/
backend/venv/
backend/django/venv/
backend/ENV/

# === Node.js ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Next.js / Turborepo ===
.next/
out/
.turbo/
build/
dist/

# === IDE ===
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# === Logs ===
logs/
*.log
backend/logs/

# === Testing ===
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# === OS ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === Build Artifacts ===
*.pyc
*.pyo
*.exe
*.dll
*.so
*.dylib

# === Misc ===
.cache/
.temp/
.tmp/
*.bak
*.backup
